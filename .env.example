# ──────────────────────────────────────────────────────────────────────────
# World Cup 2026 app — environment variables
# Everything is optional: the app runs on the free, keyless ESPN data source.
# ──────────────────────────────────────────────────────────────────────────

# AI match summaries (Claude). Without it, a templated recap is shown instead.
ANTHROPIC_API_KEY=

# Optional: Postgres + Redis (caching / history). In-memory cache is used otherwise.
DATABASE_URL=
REDIS_URL=

# Shared secret the poller uses to call POST /api/revalidate
REVALIDATE_SECRET=change-me

# Public site URL (absolute links / poller revalidation)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
