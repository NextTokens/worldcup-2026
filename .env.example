# ──────────────────────────────────────────────────────────────────────────
# World Cup 2026 app — environment variables
# Copy to .env.local for development. On Railway, set these as service vars.
# ──────────────────────────────────────────────────────────────────────────

# Postgres (Railway managed). Reference var: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://user:pass@localhost:5432/worldcup

# Redis (Railway managed). Reference var: ${{Redis.REDIS_URL}}
REDIS_URL=redis://localhost:6379

# football-data.org free tier API key (https://www.football-data.org/client/register)
# Required for authoritative fixtures + standings. Free tier: 10 req/min.
FOOTBALL_DATA_API_KEY=

# Which provider supplies LIVE in-match events. Path A (default) = ESPN (free, unofficial).
# Path B = api-football (sanctioned, paid). See ARCHITECTURE.md §0.
LIVE_PROVIDER=espn

# api-football key (only needed if LIVE_PROVIDER=api-football)
API_FOOTBALL_KEY=

# Anthropic API key for AI match summaries (Phase 3)
ANTHROPIC_API_KEY=

# Shared secret the poller uses to call POST /api/revalidate
REVALIDATE_SECRET=change-me

# Public site URL (used for absolute links / hreflang)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
