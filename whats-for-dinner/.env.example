# ──────────────────────────────────────────────────────────────────────────
# What's for Dinner — environment
# ──────────────────────────────────────────────────────────────────────────

# REQUIRED. Postgres. On Railway, add a Postgres database and reference it
# from this service; Railway sets this for you.
DATABASE_URL=

# OpenAI. Without it the app still works: suggestions fall back to the
# built-in ranking of your own dishes against your pantry.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=45000

# Shared family passcode. Leave empty and the app is open to anyone with the
# URL — fine locally, not fine on a public deployment.
APP_PASSWORD=

# Signs the session cookie. Any long random string. Changing it signs everyone
# out. Defaults to APP_PASSWORD if unset.
SESSION_SECRET=

# IANA timezone used to decide which calendar day "tonight" is.
APP_TIMEZONE=Europe/London
